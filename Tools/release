#!/usr/bin/env bash
# Cut a release: sync the manifest, set the version, check, commit, tag. Pushing is
# left to you; the tag triggers .github/workflows/release.yml.
#
#   Tools/release 0.2.0
#   git push --follow-tags
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"

version="${1:?usage: Tools/release <version>, e.g. 0.2.0}"
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "The version must look like 0.2.0." >&2; exit 1 ;;
esac

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Commit or stash your changes first." >&2
  exit 1
fi

Tools/sync-manifest
echo "$version" > VERSION
sed -i.bak -e "s/^  version \".*\"/  version \"$version\"/" Formula/desertant.rb && rm Formula/desertant.rb.bak
Tools/embed
Tools/check

git add -A
# The version may already be in place; the tag is the release either way.
git diff --cached --quiet || git commit -m "Release $version"
git tag -a "v$version" -m "desertant $version"
echo
echo "Tagged v$version. Publish with: git push --follow-tags"
