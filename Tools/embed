#!/usr/bin/env bash
# Generate Sources/DesertAntCLI/Generated/Embedded.swift from manifest.json, VERSION,
# llms.txt, docs/*.md, and templates/*.yml, so the binary is one file that shows its
# docs and runs its flow templates offline.
#
#   Tools/embed
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
out="$here/Sources/DesertAntCLI/Generated/Embedded.swift"
version="$(tr -d '[:space:]' < "$here/VERSION")"

python3 - "$here" "$version" "$out" <<'PY'
import json, sys
from pathlib import Path
root, version, out = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])

def raw(text, what):
    text = text.rstrip()
    if '"""###' in text:
        raise SystemExit(f"{what} contains the raw string terminator")
    return f'###"""\n{text}\n"""###'

manifest = (root / "manifest.json").read_text(encoding="utf-8")
json.loads(manifest)  # a broken manifest fails here, not at runtime

pages = [("index", root / "llms.txt")]
pages += [(p.stem, p) for p in sorted((root / "docs").glob("*.md"))]
# The agent adapters too, so `desertant docs skill` hands an agent its own setup.
pages += [("skill", root / "integrations/claude/skills/desertant/SKILL.md"),
          ("codex", root / "integrations/codex/AGENTS.md")]
docs = ",\n".join(
    f'        (name: "{name}", markdown: {raw(path.read_text(encoding="utf-8"), path.name)})'
    for name, path in pages
)

templates = sorted((root / "templates").glob("*.yml"))
flows = ",\n".join(
    f'        (name: "{path.stem}", yaml: {raw(path.read_text(encoding="utf-8"), path.name)})'
    for path in templates
)

out.write_text(f'''// Generated by Tools/embed from manifest.json, VERSION, llms.txt, docs/, and
// templates/. Do not edit by hand.

enum Embedded {{
    static let version = "{version}"

    static let manifest = {raw(manifest, "manifest.json")}

    /// The docs, index first, then docs/*.md by file name.
    static let docs: [(name: String, markdown: String)] = [
{docs},
    ]

    /// The flow templates, by file name.
    static let templates: [(name: String, yaml: String)] = [
{flows}{"," if templates else ""}
    ]
}}
''', encoding="utf-8")
print(f"Embedded the manifest, version {version}, {len(pages)} doc pages, and {len(templates)} flow templates.")
PY
