#!/usr/bin/env bash
# Record the README's demos with a built desertant: the demo episode, the terminal
# recordings in docs/media/*.tape. The episode is Tests/Fixtures/talk.wav over a public domain clip of a Formica fusca ant by
# Samuel Koivisto, from Wikimedia Commons. The models run once first, so the recordings
# show a second run. Needs curl, ffmpeg, and vhs.
#
#   Tools/record-demos [path-to-desertant]      default: desertant on PATH
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
da="$(cd "$(dirname "${1:-$(command -v desertant)}")" && pwd)/$(basename "${1:-desertant}")"
demo=/Users/Shared/desertant-demo
media="$here/docs/media"
talk="$here/Tests/Fixtures/talk.wav"
footage_url=https://upload.wikimedia.org/wikipedia/commons/d/dd/Ffusca.webm
footage_sha1=a5e219d52b9205409347fa7914476dfb61cdfae7

footage="$(mktemp -d)/ffusca.webm"
trap 'rm -rf "$(dirname "$footage")"' EXIT
curl -fsSL -A "desertant-record-demos" -o "$footage" "$footage_url"
[ "$(shasum "$footage" | cut -d' ' -f1)" = "$footage_sha1" ] || { echo "The footage did not match its checksum." >&2; exit 1; }

rm -rf "$demo" && mkdir -p "$demo/bin" "$media"
ln -s "$da" "$demo/bin/da"
export PATH="$demo/bin:$PATH" DESERTANT_NO_UPDATE_CHECK=1
cd "$demo"

# The episode: the footage looped, cropped around the ant, with the fixture's speech.
duration="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$talk")"
width=1920 height=1080
ffmpeg -v error -y -stream_loop -1 -i "$footage" -i "$talk" \
  -filter_complex "[0:v]scale=${width}:${height}:force_original_aspect_ratio=increase,crop=${width}:${height}:(iw-${width})*0.45:(ih-${height})/2,setsar=1,fps=30,format=yuv420p[v]" \
  -map "[v]" -map 1:a -t "$duration" -c:v libx264 -crf 18 -preset medium -c:a aac -b:a 160k episode.mp4

# A first run loads the models and prepares them for the Neural Engine.
da flow run podcast-clips episode.mp4 --output-dir warm --quiet >/dev/null

cd "$here"
for tape in "$media"/*.tape; do vhs "$tape" >/dev/null; done

echo "Recorded $(ls "$media" | grep -v '\.tape$' | tr '\n' ' ')"
