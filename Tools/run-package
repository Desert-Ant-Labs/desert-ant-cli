#!/usr/bin/env bash
# Unpack a release tarball into an empty folder and run models from it, the way an
# install runs them. A file the tarball misses, such as Tongue's bundle in 0.2.1,
# fails here instead of on a user's machine. CI and the release run this after
# Tools/package.
#
#   Tools/run-package dist/desertant-<target>.tar.gz
set -euo pipefail
tarball="$(cd "$(dirname "${1:?usage: Tools/run-package <tarball>}")" && pwd)/$(basename "$1")"
dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT
mkdir "$dir/install" "$dir/elsewhere"
tar -xzf "$tarball" -C "$dir/install"
cd "$dir/elsewhere"

da="$dir/install/desertant"
"$da" --version
if ! out="$("$da" tongue "Bonjour, comment allez-vous aujourd'hui ?" --json)"; then
  echo "Tongue could not run from $(basename "$tarball")." >&2
  exit 1
fi
language="$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['language'])" "$out")"
if [[ "$language" != fr ]]; then
  echo "Tongue answered $language for French text." >&2
  exit 1
fi
echo "Tongue runs from $(basename "$tarball")."
