#!/usr/bin/env bash
# Build in release and install desertant, with a `da` alias, for this user: the
# binary and its companions in DESERTANT_HOME (~/.local/share/desertant), symlinks
# in ~/.local/bin or the directory passed. It installs the same tarball
# Tools/package makes for a release, so a local install and a released one hold
# the same files.
#
#   Tools/install [bin-directory]
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
bindir="${1:-$HOME/.local/bin}"
home="${DESERTANT_HOME:-$HOME/.local/share/desertant}"

case "$(uname -s)" in Darwin) os=darwin ;; Linux) os=linux ;; *) echo "No build for $(uname -s)." >&2; exit 1 ;; esac
case "$(uname -m)" in arm64 | aarch64) arch=arm64 ;; x86_64 | amd64) arch=x86_64 ;; *) echo "No build for $(uname -m)." >&2; exit 1 ;; esac

tarball="$("$here/Tools/package" "$os-$arch" | tail -1)"

mkdir -p "$home" "$bindir"
tar -xzf "$here/$tarball" -C "$home"
ln -sf "$home/desertant" "$bindir/desertant"
ln -sf "$home/desertant" "$bindir/da"

echo "Installed desertant and da into $bindir."
echo "Make sure $bindir is on your PATH."
